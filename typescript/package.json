{
  "name": "@gaiadesk/sdk",
  "version": "0.1.0",
  "description": "Drive GaiaDesk desks from Node.js: devices, exec, shell, file copy, background jobs, stats, scoped tokens and MCP, through gaiadesk-cli.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["gaiadesk", "remote-desktop", "sdk", "exec", "mcp", "ai-agents"],
  "homepage": "https://gaiadesk.net/docs/cli-for-agents"
}
